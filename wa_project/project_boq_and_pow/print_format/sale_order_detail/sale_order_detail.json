 "doctype": "Print Format",
 "font_size": 14,
 "html": "{% set lh = frappe.get_doc(\"Letter Head\", content) %}\n\n{% set s = frappe.get_doc(\"Payment Entry\", content) %}\n{% set cname = frappe.get_doc(\"Company\", company_logo) %}\n{% set it = frappe.utils.getdate(frappe.utils.get_datetime()) %}\n\n{% set total_due = frappe.get_doc(\"Sales Order\", grand_total)  %}\n{% set paid_amount = frappe.get_doc(\"Sales Order\", advance_paid)  %}\n{% set tot_bals = total_due.grand_total - paid_amount.advance_paid %}\n\n\n\n<div class=\"print-heading\" style=\"text-align: center; \">\n\t\t{% if lh %}\n\t\t{{ lh.content }}\n\t\t{% endif %}\n\t\n    <h4>Sales Order Details</h4>\t\n\n</div>\n\n<div class=\"receipt-head\" style=\"font-family: 'Open Sans'; font-size: 12px; align-items: left;\">\n\t<div class=\"column\"  >\n\t\t<div class=\"col-md-6 text-left\" style=\"display: flex; margin-bottom: 5px; \">\n\t\t\t<div style=\"font-weight: bold; width: 60%;\">\n\t\t\t\tCustomer: \n\t\t\t</div>\t\n\t\t\t<div>\n\t\t\t\t{{ doc.customer }}\n\t\t\t</div>\n\t\t</div> \n\t</div>\n\t<div class=\"column\"  >\n\t\t<div class=\"col-md-6 text-left\" style=\"display: flex; margin-bottom: 0px;\">\n\t\t\t<div style=\"font-weight: bold; width: 50%;\">\n\t\t\t\tSales Order: \n\t\t\t</div>\t\n\t\t\t<div>\n\t\t\t\t{{ doc.name}}\n\t\t\t</div>\n\t\t</div>    \n\t</div>\n</div>\n\n<div><br>  <h5>Items</h5>\t\n</div>\n\n<font size=\"8\" face=\"Open Sans\">\n\t<table class=\"table table-bordered\" style=\"font-size: 11px; ;\">\n\t\t<tbody>\n\t\t\t<tr>\n\t\t\t\t<th>No.</th>\n\t\t\t\t<th>Item Name</th>\n\t\t\t\t<th class=\"text-right\">Quantity</th>\n\t\t\t\t<th class=\"text-right\">Rate</th>\n\t\t\t\t<th class=\"text-right\">Amount</th>\n\t\n\t\t\t</tr>\n\t\t\t{%- for row in doc.items -%}\n\t\t\t<tr>\n\t\t\t\t<td style=\"width: 5%;\">{{ row.idx }}</td>\n\t\t\t\t<td style=\"width: 35%;\">\n\t\t\t\t\t{{ row.item_code }}\n\t\t\t\t\t{%- if row.item_name != row.item_code -%}\n\t\t\t\t\t\t<br>{{ row.item_name }}\n\t\t\t\t\t{%- endif -%}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\" style=\"width: 15%;\">\n\t\t\t\t\t{{ row.qty}} {{ row.uom}}\n\t\t\t\t</td>\n\t\t\t\t<td class=\"text-right\" style=\"width: 20%;\">\n\t\t\t\t\t{{ row.get_formatted(\"rate\") }}\n\t\t\t\t</td>\n\t\t\t\t\n\t\t\t\t<td class=\"text-right\" style=\"width: 25%;\">\n\t\t\t\t\t{{ row.get_formatted(\"amount\") }}\n\t\t\t\t</td>\n\t\t\t\n\n\t\t\t</tr>\n\t\t\t{%- endfor -%}\n\n\t\t</tbody>\n\t</table>\n</font>\n\n\n<div class=\"row\">\n\t<div class=\"receipt-amount\" style=\"font-family: 'Open Sans'; font-size: 12px;\">\n\t\t<div class=\"column\"  >\n\t\t\t<div class=\"col-md-6 text-left\" style=\"display: flex; margin-bottom: 5px;\">\n\t\t\t\t<div style=\"font-weight: bold; width: 50%;\">\n\t\t\t\t\tTotal Quantity: \n\t\t\t\t</div>\t\n\t\t\t\t<div >\n\t\t\t\t\t{{doc.get_formatted(\"total_qty\")}}\n\t\t\t\t</div>\n\t\t\t</div>\n\n\t\t\t<div class=\"col-md-6 text-left\" style=\"display: flex; margin-bottom: 5px;\">\n\t\t\t\t<div style=\"font-weight: bold; width: 50%;\">\n\t\t\t\t\tOutstanding Balance: \n\t\t\t\t</div>\t\n\t\t\t\t<div id=\"balance\">\n\t\t\t\t\t{{ frappe.format(tot_bals, {'fieldtype': 'Currency'}) }}\n\t\t\t\t\n\t\t\t\t\t<!-- {{ frappe.utils.fmt_money(tot_bals) }} -->\n\t\t\t\t</div>\n\t\t\t</div> \n\t\t</div>\n\t\t<div class=\"column\"  >\n\t\t\t<div class=\"col-md-6 text-left\" style=\"display: flex;\">\n\t\t\t\t<div style=\"font-weight: bold; width: 50%;\">\n\t\t\t\t\tGrand Total: \n\t\t\t\t</div>\t\n\t\t\t\t<div id=\"grandtotal\">\n\t\t\t\t\t{{ doc.get_formatted(\"grand_total\") }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t<div class=\"col-md-6 text-left\" style=\"display: flex;\">\n\t\t\t\t<div style=\"font-weight: bold; width: 50%;\">\n\t\t\t\t\tAmount Paid to date :\n\t\t\t\t</div>\t\n\t\t\t\t<div id=\"paid\">\n\t\t\t\t\t{{ doc.get_formatted(\"advance_paid\") }}\n\t\t\t\t</div>\n\t\t\t</div>\n\t\t\t   \n\t\t\n\t\t</div>\n\t</div>\n</div>",
